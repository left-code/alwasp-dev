---
interface Props {
  href: string;
  title: string;
  description: string;
  label?: string;
}

const { href, title, description, label = "Open" } = Astro.props;
---

<a href={href} class="group relative block overflow-hidden rounded-xl border border-ink-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-wasp-300 hover:shadow-soft">
  <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-wasp-300 transition group-hover:scale-x-100"></span>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-base font-semibold text-ink-900">{title}</h3>
      <p class="mt-2 text-sm leading-6 text-ink-700">{description}</p>
    </div>
    <span class="shrink-0 rounded-md bg-ink-100 px-2.5 py-1 text-xs font-semibold text-ink-700 group-hover:bg-wasp-100 group-hover:text-ink-900">
      {label} <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
