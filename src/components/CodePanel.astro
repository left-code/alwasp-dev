---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description: string;
  filename: string;
  code: string;
  tone?: "wasp" | "mint" | "ink";
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  filename,
  code,
  tone = "wasp",
  class: className = ""
} = Astro.props;

const tones = {
  wasp: "bg-wasp-300 text-wasp-700",
  mint: "bg-mint-500 text-mint-700",
  ink: "bg-ink-500 text-ink-700"
};
---

<article id={id} class:list={["group scroll-mt-28 overflow-hidden rounded-xl border border-ink-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-soft", className]}>
  <div class:list={["h-1", tones[tone].split(" ")[0]]}></div>
  <div class="p-5 sm:p-6">
    <p class:list={["text-xs font-bold uppercase tracking-[0.16em]", tones[tone].split(" ")[1]]}>{eyebrow}</p>
    <h2 class="mt-2 text-xl font-semibold text-ink-900">{title}</h2>
    <p class="mt-2 text-sm leading-6 text-ink-700">{description}</p>
  </div>
  <div class="mx-3 mb-3 overflow-hidden rounded-lg border border-white/10 bg-[#0b101a] sm:mx-4 sm:mb-4">
    <div class="flex items-center justify-between border-b border-white/10 bg-white/[0.04] px-4 py-2.5">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="h-2 w-2 rounded-full bg-[#ff6b6b]"></span>
        <span class="h-2 w-2 rounded-full bg-wasp-300"></span>
        <span class="h-2 w-2 rounded-full bg-mint-500"></span>
      </div>
      <span class="font-mono text-[10px] text-ink-500">{filename}</span>
    </div>
    <pre class="max-h-[34rem] overflow-auto p-4 font-mono text-[12px] leading-6 text-ink-200 sm:p-5"><code>{code}</code></pre>
  </div>
</article>
