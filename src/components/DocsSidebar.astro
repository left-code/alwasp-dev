---
import type { CollectionEntry } from "astro:content";

interface Props {
  docs: CollectionEntry<"docs">[];
  currentSlug?: string;
}

const { docs, currentSlug } = Astro.props;
const sortedDocs = [...docs].sort((a, b) => a.data.order - b.data.order);
const essentials = sortedDocs.filter((doc) => doc.data.order <= 5);
const reference = sortedDocs.filter((doc) => doc.data.order > 5);

const groups = [
  { title: "Learn", docs: essentials },
  { title: "Reference", docs: reference }
];
---

<div>
  <details class="rounded-xl border border-ink-200 bg-white p-2 shadow-sm lg:hidden">
    <summary class="cursor-pointer list-none rounded-md px-3 py-2 text-sm font-semibold text-ink-900 marker:content-none">Browse documentation <span class="float-right text-ink-500">↓</span></summary>
    <nav class="mt-2 border-t border-ink-200 pt-2" aria-label="Documentation navigation">
      {sortedDocs.map((doc) => {
        const active = doc.id === currentSlug;
        return <a href={`/docs/${doc.id}/`} aria-current={active ? "page" : undefined} class:list={["block rounded-md px-3 py-2 text-sm", active ? "bg-wasp-100 font-semibold text-ink-900" : "text-ink-700 hover:bg-ink-100"]}>{doc.data.title}</a>;
      })}
    </nav>
  </details>

  <aside class="hidden lg:sticky lg:top-24 lg:block lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto">
    <nav class="space-y-6" aria-label="Documentation navigation">
      {groups.map((group) => (
        <div>
          <div class="mb-2 px-3 text-[11px] font-bold uppercase tracking-[0.16em] text-ink-500">{group.title}</div>
          <div class="space-y-1">
            {group.docs.map((doc) => {
              const active = doc.id === currentSlug;
              return (
                <a
                  href={`/docs/${doc.id}/`}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-md border-l-2 px-3 py-2 text-sm transition",
                    active ? "border-wasp-500 bg-wasp-100 font-semibold text-ink-900" : "border-transparent text-ink-700 hover:border-ink-300 hover:bg-white hover:text-ink-900"
                  ]}
                >
                  {doc.data.title}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </nav>
  </aside>
</div>
