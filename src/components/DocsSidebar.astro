---
import type { CollectionEntry } from "astro:content";

interface Props {
  docs: CollectionEntry<"docs">[];
  currentSlug?: string;
}

const { docs, currentSlug } = Astro.props;
const sortedDocs = [...docs].sort((a, b) => a.data.order - b.data.order);
---

<aside class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
  <div class="rounded-lg border border-ink-200 bg-white p-3">
    <div class="px-3 pb-2 text-xs font-semibold uppercase tracking-wide text-ink-500">Documentation</div>
    <nav class="space-y-1" aria-label="Documentation navigation">
      {sortedDocs.map((doc) => {
        const active = doc.slug === currentSlug;
        return (
          <a
            href={`/docs/${doc.slug}/`}
            class:list={[
              "block rounded-md px-3 py-2 text-sm transition",
              active
                ? "bg-wasp-100 font-semibold text-ink-900"
                : "text-ink-700 hover:bg-ink-100 hover:text-ink-900"
            ]}
          >
            {doc.data.title}
          </a>
        );
      })}
    </nav>
  </div>
</aside>
