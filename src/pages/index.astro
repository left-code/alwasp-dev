---
import BaseLayout from "@layouts/BaseLayout.astro";
import CardLink from "@components/CardLink.astro";
import { getCollection } from "astro:content";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Documentation" description="ALWasp documentation site for restore, build, compatibility validation, package comparison, configuration, and CI workflows.">
  <main>
    <section class="border-b border-ink-200 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[minmax(0,1fr)_440px] lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-wasp-700">ALWasp documentation</p>
          <h1 class="mt-3 text-5xl font-semibold tracking-normal text-ink-900">Restore symbols, compile AL projects, and run reproducible Business Central builds.</h1>
          <p class="mt-5 text-lg leading-8 text-ink-700">
            ALWasp is a .NET 8 CLI for Business Central AL repositories, covering NuGet symbol restore, config-driven builds, public-symbol package comparison, AppSourceCop compatibility validation, version calculation, and CI-ready manifests.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/docs/getting-started/" class="rounded-md bg-ink-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-ink-700">Get started</a>
            <a href="/examples/" class="rounded-md border border-ink-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink-900 transition hover:bg-ink-100">View examples</a>
          </div>
        </div>
        <div class="rounded-lg border border-ink-200 bg-ink-900 p-5 text-ink-50 shadow-soft">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <img src="/icon.png" alt="" class="h-10 w-10 rounded-md" />
            <div>
              <div class="font-semibold">Quick build path</div>
              <div class="text-sm text-ink-200">Config-driven workflow</div>
            </div>
          </div>
          <pre class="mt-5 overflow-x-auto text-[13px] leading-7 xl:text-sm"><code>dotnet tool install --global left-code.AlWasp
alwasp init
alwasp config validate
alwasp restore
alwasp build ci</code></pre>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {docs.map((doc) => (
          <CardLink href={`/docs/${doc.id}/`} title={doc.data.title} description={doc.data.description} label="Read" />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
