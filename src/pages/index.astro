---
import BaseLayout from "@layouts/BaseLayout.astro";
import CardLink from "@components/CardLink.astro";
import GitHubIcon from "@components/GitHubIcon.astro";
import { getCollection } from "astro:content";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const learn = docs.filter((doc) => doc.data.order <= 5);
const reference = docs.filter((doc) => doc.data.order > 5);

const capabilities = [
  {
    number: "01",
    title: "Restore with confidence",
    description: "Resolve Business Central symbols from NuGet and authenticated feeds with deterministic, incremental restores.",
    accent: "bg-mint-500"
  },
  {
    number: "02",
    title: "Build as one workspace",
    description: "Compile dependency-aware AL projects from a single configuration with temporary, reversible transforms.",
    accent: "bg-wasp-300"
  },
  {
    number: "03",
    title: "Ship behind quality gates",
    description: "Compare public symbols, validate AppSource compatibility, and emit manifests your CI pipeline can trust.",
    accent: "bg-ink-500"
  }
];
---

<BaseLayout title="Build and release Business Central AL with confidence" description="ALWasp restores symbols, builds dependency-aware Business Central AL workspaces, validates compatibility, and powers reproducible CI workflows.">
  <main>
    <section class="hero-grid relative isolate overflow-hidden border-b border-ink-900 bg-ink-900 text-white">
      <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-wasp-300/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-mint-500/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,1fr)_460px] lg:items-center lg:gap-16 lg:px-8 lg:py-24">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-ink-200 backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-mint-500 shadow-[0_0_12px_rgba(47,159,116,0.9)]"></span>
            Free-to-use .NET CLI for AL
          </div>

          <h1 class="mt-6 max-w-3xl text-5xl font-semibold leading-[1.03] tracking-tight sm:text-6xl lg:text-7xl">
            Less build friction.<br /><span class="text-wasp-300">Better AL releases.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-200 sm:text-xl">
            Restore symbols, compile dependency-aware workspaces, and validate Business Central packages with one focused tool—from local development to CI.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/docs/getting-started/" class="rounded-md bg-wasp-300 px-5 py-3 text-sm font-bold text-ink-900 shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-wasp-100">Get started</a>
            <a href="https://github.com/left-code/alwasp-dev" target="_blank" rel="noreferrer" class="flex items-center gap-2 rounded-md border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/10">
              <GitHubIcon class="h-5 w-5" />
              Docs &amp; feedback on GitHub
            </a>
            <a href="/examples/" class="px-3 py-3 text-sm font-semibold text-ink-200 transition hover:text-white">Browse examples <span aria-hidden="true">→</span></a>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/10 pt-6 text-sm text-ink-200">
            <span class="flex items-center gap-2"><span class="text-mint-500">✓</span> NuGet symbol restore</span>
            <span class="flex items-center gap-2"><span class="text-mint-500">✓</span> Reproducible builds</span>
            <span class="flex items-center gap-2"><span class="text-mint-500">✓</span> CI-ready outputs</span>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-3 rounded-2xl bg-gradient-to-br from-wasp-300/20 to-mint-500/10 blur-xl"></div>
          <div class="relative overflow-hidden rounded-xl border border-white/15 bg-[#0b101a] shadow-2xl shadow-black/40">
            <div class="flex items-center justify-between border-b border-white/10 bg-white/[0.04] px-4 py-3">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-[#ff6b6b]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-wasp-300"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-mint-500"></span>
              </div>
              <span class="font-mono text-[11px] text-ink-500">terminal · alwasp</span>
            </div>
            <div class="p-5 sm:p-6">
              <div class="flex items-center gap-3 border-b border-white/10 pb-5">
                <img src="/icon.png" alt="" class="h-11 w-11 rounded-lg ring-1 ring-white/10" />
                <div>
                  <p class="font-semibold text-white">From zero to verified build</p>
                  <p class="mt-0.5 text-sm text-ink-500">One configuration, every environment</p>
                </div>
              </div>
              <pre class="mt-5 overflow-x-auto font-mono text-[13px] leading-7 text-ink-200"><code><span class="text-mint-500">$</span> dotnet tool install -g left-code.AlWasp

<span class="text-mint-500">$</span> alwasp init
<span class="text-ink-500">✓ Configuration created</span>

<span class="text-mint-500">$</span> alwasp build ci
<span class="text-ink-500">✓ Symbols restored</span>
<span class="text-ink-500">✓ 4 projects compiled</span>
<span class="text-wasp-300">✓ Build manifest written</span></code></pre>
            </div>
            <div class="grid grid-cols-3 border-t border-white/10 bg-white/[0.03] text-center">
              <div class="px-2 py-3"><div class="text-xs font-semibold text-white">Restore</div><div class="mt-1 text-[10px] uppercase tracking-wider text-ink-500">Symbols</div></div>
              <div class="border-x border-white/10 px-2 py-3"><div class="text-xs font-semibold text-white">Build</div><div class="mt-1 text-[10px] uppercase tracking-wider text-ink-500">Workspace</div></div>
              <div class="px-2 py-3"><div class="text-xs font-semibold text-white">Validate</div><div class="mt-1 text-[10px] uppercase tracking-wider text-ink-500">Release</div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-ink-200 bg-white">
      <div class="mx-auto grid max-w-7xl md:grid-cols-3">
        {capabilities.map((item, index) => (
          <article class:list={["relative px-6 py-8 lg:px-8 lg:py-10", index > 0 && "border-t border-ink-200 md:border-l md:border-t-0"]}>
            <div class:list={["absolute left-0 top-8 h-8 w-1 rounded-r-full lg:top-10", item.accent]}></div>
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-ink-500">{item.number}</span>
              <h2 class="text-lg font-semibold text-ink-900">{item.title}</h2>
            </div>
            <p class="mt-3 text-sm leading-6 text-ink-700">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="mx-auto max-w-7xl space-y-14 px-4 py-14 sm:px-6 lg:px-8 lg:py-18">
      <section>
        <div class="mb-7 max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-mint-700">Learn the workflow</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">From setup to release confidence.</h2>
          <p class="mt-3 text-base leading-7 text-ink-700">These guides form the core path through a typical ALWasp repository.</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {learn.map((doc) => (
            <CardLink href={`/docs/${doc.id}/`} title={doc.data.title} description={doc.data.description} label="Open" />
          ))}
        </div>
      </section>

      <section>
        <div class="mb-7 max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-wasp-700">Operate and extend</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">Reference for real pipelines.</h2>
          <p class="mt-3 text-base leading-7 text-ink-700">Authentication, commands, internals, and automation when you need exact behavior.</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {reference.map((doc) => (
            <CardLink href={`/docs/${doc.id}/`} title={doc.data.title} description={doc.data.description} label="Open" />
          ))}
        </div>
      </section>

      <section class="grid gap-5 pb-2 md:grid-cols-2">
        <a href="/examples/" class="group rounded-xl border border-ink-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-mint-500 hover:shadow-soft">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-mint-700">Need working code?</p>
          <h2 class="mt-2 text-xl font-semibold text-ink-900">Browse copy-ready examples <span aria-hidden="true">→</span></h2>
          <p class="mt-2 text-sm leading-6 text-ink-700">Configuration, GitHub Actions, private feeds, versioning, and compatibility gates.</p>
        </a>
        <a href="/cheatsheet/" class="group rounded-xl border border-ink-900 bg-ink-900 p-6 text-white shadow-sm transition hover:-translate-y-0.5 hover:border-wasp-300 hover:shadow-soft">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-wasp-300">Need a quick answer?</p>
          <h2 class="mt-2 text-xl font-semibold">Open the cheatsheet <span aria-hidden="true">→</span></h2>
          <p class="mt-2 text-sm leading-6 text-ink-200">Commands, configuration anatomy, version rules, compatibility, and CI signals.</p>
        </a>
      </section>
    </div>
  </main>

  <style>
    .hero-grid {
      background-image:
        linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
      background-size: 44px 44px;
    }
  </style>
</BaseLayout>
